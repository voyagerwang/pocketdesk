<?xml version="1.0" encoding="UTF-8"?>
<!-- [INPUT]: 由 install-app.sh 复制进 App bundle。 [OUTPUT]: 声明 PocketDesk 的独立应用身份与访达自动化用途（读取访达多选发送文件）。 [POS]: Resources 的 macOS bundle 元数据。 [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>zh_CN</string>
  <key>CFBundleExecutable</key><string>VoiceDeck</string>
  <key>CFBundleIdentifier</key><string>dev.voicedeck.app</string>
  <key>CFBundleName</key><string>PocketDesk</string>
  <key>CFBundleDisplayName</key><string>PocketDesk</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.3.1</string>
  <key>CFBundleVersion</key><string>4</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <!-- ScreenCaptureKit 的 TCC 强制要求：缺失本键时 CGRequestScreenCaptureAccess() 会直接终止进程，而不是弹窗。 -->
  <key>NSScreenCaptureUsageDescription</key><string>PocketDesk 需要屏幕录制权限，用于在手机端查看这台 Mac 的画面。</string>
  <!-- 文件发送读取访达多选：发送给手机前需用户在系统设置允许 PocketDesk 自动化访问访达。 -->
  <key>NSAppleEventsUsageDescription</key><string>PocketDesk 需要访问访达，读取你选中的文件以便发送到你的手机。</string>
</dict>
</plist>
